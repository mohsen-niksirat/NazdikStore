# Production environment template
# Copy to .env — NEVER commit .env

# ── Core ──
NODE_ENV=production
PORT=4000
CORS_ORIGINS=https://your-domain.ir
WEB_BASE_URL=https://your-domain.ir
API_BASE_URL=https://api.your-domain.ir
ALLOW_OFFLINE=0
ALLOW_DEV_LOGIN=0
SEED_MAP=0

# ── Data ──
DATABASE_URL=postgresql://user:pass@host:5432/nazdik?schema=public
REDIS_URL=redis://host:6379
POSTGRES_USER=nazdik
POSTGRES_PASSWORD=
POSTGRES_DB=nazdik

# ── Auth ──
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=14

# ── OTP / SMS (Iran) ──
# console | kavenegar | smsir
SMS_PROVIDER=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
SMSIR_API_KEY=
SMSIR_LINE_NUMBER=
OTP_TTL_SECONDS=120
OTP_LENGTH=5
OTP_MAX_PER_WINDOW=3
OTP_WINDOW_SECONDS=300

# ── Payments ──
# mock | zarinpal | saman
PAYMENT_PROVIDER=zarinpal
PAYMENT_HMAC_SECRET=
ZARINPAL_API_KEY=
ZARINPAL_SANDBOX=0
SAMAN_MERCHANT_ID=
PLATFORM_COMMISSION_BPS=1000

# ── Map ──
MAP_TILES_URL=
MEDIA_ROOT=/var/nazdik/uploads
