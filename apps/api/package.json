{
  "name": "@nazdik/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node test/mini-server.cjs",
    "dev:api": "nest start --watch",
    "dev:nest": "nest start --watch",
    "start:local": "node test/mini-server.cjs",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "test": "node test/run-phase1.cjs && node test/run-phase2.cjs && node test/run-phase3.cjs && node test/run-phase4.cjs && node test/run-phase5.cjs",
    "test:phase1": "node test/run-phase1.cjs",
    "test:phase2": "node test/run-phase2.cjs",
    "test:phase3": "node test/run-phase3.cjs",
    "test:phase4": "node test/run-phase4.cjs",
    "test:phase5": "node test/run-phase5.cjs",
    "test:prod6": "node test/run-prod-phase6.cjs",
    "test:prod7": "node test/run-prod-phase7.cjs",
    "test:jest": "jest --config test/jest.config.js --runInBand",
    "test:watch": "jest --config test/jest.config.js --watch",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@nazdik/shared": "*",
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.12",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.12",
    "@nestjs/swagger": "^11.1.0",
    "@prisma/client": "^6.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@nestjs/testing": "^11.0.12",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^6.5.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.2.6",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.2"
  }
}
